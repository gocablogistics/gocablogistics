[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Pinned, not "*" — confirmed this is what's actually deployed
# (Pipfile.lock had it locked at this version already). Left unpinned,
# a fresh resolve (which `pipenv install --dev` does whenever the lock
# looks stale, e.g. after the python_version fix below) grabs whatever
# the newest Django is — that's exactly how CI broke: it pulled Django
# 5.x, which removed CheckConstraint's `check=` kwarg (renamed to
# `condition=` back in 4.1, gone for real in 5.1) that models.py relies
# on. Bump this deliberately, together with the CheckConstraint call
# sites, not by accident via an unpinned resolve.
django = "==4.2.30"
dj-database-url = "*"
psycopg2 = "*"
channels = {extras = ["daphne"], version = "*"}
channels-redis = "*"
django-background-tasks = "*"
whitenoise = "*"
django-redis = "*"
redis = "*"
googlemaps = "*"
python-dotenv = "*"
black = "*"
django-ninja = "*"
django-ninja-jwt = "*"
django-cors-headers = "*"
argon2-cffi = "*"
email-validator = "*"
django-cloudinary-storage = "*"
cloudinary = "*"
phonenumbers = "*"
firebase-admin = "*"
sentry-sdk = {extras = ["django"], version = "*"}

[dev-packages]

[requires]
# Production actually runs 3.12 (confirmed directly on the server's venv,
# /srv/gocab/venv/bin/python3.12) — this was stale at 3.9 and would make
# `pipenv install --deploy` in CI fail on a version mismatch that was
# never real to begin with.
python_version = "3.12"
