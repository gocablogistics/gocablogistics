<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ requires this to actually show a notification, even
         though the app has always been able to receive pushes silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- GocabLocationService — no ACCESS_BACKGROUND_LOCATION needed: a
         foreground service with a visible ongoing notification counts as
         the app being "in use" for location purposes. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application>
        <service
            android:name="com.gocab.nativeplugin.GocabFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Routes a notification-payload message that arrives while the app
             is backgrounded (and so never reaches onMessageReceived) into
             this channel instead of Android's unthemed default one. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="gocab_default" />

        <service
            android:name="com.gocab.nativeplugin.GocabLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
