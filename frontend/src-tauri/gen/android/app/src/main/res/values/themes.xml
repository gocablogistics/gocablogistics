<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Matches the SPA's own dark background
         (#20241f, see src/index.css) so the native status/nav bar chrome
         doesn't flash a mismatched default color around the WebView on
         launch or during route transitions. -->
    <style name="Theme.gocab" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">#20241f</item>
        <item name="android:navigationBarColor">#20241f</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#20241f</item>
    </style>

    <!-- Native splash screen, shown the instant the app icon is tapped —
         before Tauri's WebView has even started loading. MainActivity's
         theme (see AndroidManifest.xml) during the short cold-start gap;
         installSplashScreen() in MainActivity.kt swaps it for Theme.gocab
         above the moment onCreate() runs. Same dark background and same
         logo as everywhere else in the app (index.css, the launcher icon),
         so there's no color or brand mismatch across the handoff from this
         native splash into the app's own animated Loader component. -->
    <style name="Theme.gocab.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#20241f</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.gocab</item>
    </style>
</resources>
