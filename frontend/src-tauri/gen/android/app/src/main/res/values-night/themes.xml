<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — same dark background in both variants
         since the SPA itself doesn't have a separate light theme. -->
    <style name="Theme.gocab" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">#20241f</item>
        <item name="android:navigationBarColor">#20241f</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#20241f</item>
    </style>

    <!-- Same splash as values/themes.xml — identical in both since the app
         has only ever had the one dark theme. -->
    <style name="Theme.gocab.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#20241f</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.gocab</item>
    </style>
</resources>
